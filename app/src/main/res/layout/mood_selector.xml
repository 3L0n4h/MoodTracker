<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMoodSelector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview_mad"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:rippleColor="@android:color/transparent">

        <ImageView
            android:id="@+id/imgview_mad"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mood_mad"
            android:contentDescription="mood angry"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview_sad"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:rippleColor="@android:color/transparent">

        <ImageView
            android:id="@+id/imgview_sad"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mood_sad"
            android:contentDescription="mood sad"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview_neutral"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:rippleColor="@android:color/transparent">

        <ImageView
            android:id="@+id/imgview_neutral"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mood_neutral"
            android:contentDescription="mood neutral"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview_happy"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:rippleColor="@android:color/transparent">

        <ImageView
            android:id="@+id/imgview_happy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mood_happy"
            android:contentDescription="mood happy"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview_excited"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:rippleColor="@android:color/transparent">

        <ImageView
            android:id="@+id/imgview_excited"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mood_excited"
            android:contentDescription="mood excited"/>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>